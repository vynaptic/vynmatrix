# vynmatrix Environment Variables

# =============================================================================
# Environment
# =============================================================================
ENV=dev  # Options: dev, test, staging, prod
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
# Must exceed the shared 45-second total shutdown budget and leave room for
# broker, database, and child-process cleanup. Docker's default is unsafe.
APP_STOP_GRACE_PERIOD=60s

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# For local development with Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vm_trading
DB_USER=trader
DB_PASSWORD=CHANGE_ME_BEFORE_USE

# Full database URL (alternative to individual vars, takes precedence)
# DATABASE_URL=postgresql://trader:CHANGE_ME@localhost:5432/vm_trading

# Bounded process-local PostgreSQL pools. Every explicit service DATABASE_URL
# uses this same policy; startup rejects size + overflow above the budget.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_CONNECTION_BUDGET=5

# =============================================================================
# pgAdmin (Optional - for database management UI)
# =============================================================================
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
PGADMIN_PORT=5050

API_KEY=your-api-key-here
ADMIN_API_KEY=
EXEC_ENGINE_API_KEY=

# Local Compose provisions one isolated login for each runtime service. These
# defaults are development-only; production must inject six distinct secrets.
VM_BACKEND_DB_PASSWORD=vm_backend_local
VM_SCORING_DB_PASSWORD=vm_scoring_local
VM_EXECUTION_DB_PASSWORD=vm_execution_local
VM_FEEDBACK_DB_PASSWORD=vm_feedback_local
VM_MARKET_DATA_DB_PASSWORD=vm_market_data_local
VM_INDICATOR_DB_PASSWORD=vm_indicator_local

# =============================================================================
# Execution Engine
# =============================================================================
# Host-run scoring only; leave unset for Compose service DNS.
# EXEC_ENGINE_URL=http://localhost:8000
EXECUTION_MODE=paper  # backtest|paper|live
EXECUTION_ENGINE_ALLOW_LIVE=false
EXECUTION_USE_LOCAL_PAPER_BROKER=true
PAPER_BROKER_SLIPPAGE_PCT=0.001
PAPER_BROKER_COMMISSION_PCT=0.001
# Maximum committed market-time lag for durable local-paper working orders.
EXECUTION_PAPER_ORDER_MAX_LAG_SECONDS=300
EXECUTION_DEDUP_TTL_SECONDS=3600
EXECUTION_DEDUP_ALLOW_STALE_EXECUTING_RECLAIM=false
EXECUTION_DEDUP_USE_MEMORY_ONLY=false
EXECUTION_CIRCUIT_BREAKER_THRESHOLD=3
EXECUTION_CIRCUIT_BREAKER_WINDOW_SEC=300
EXECUTION_CIRCUIT_BREAKER_COOLDOWN_SEC=900
EXECUTION_RISK_GUARD_ENABLED=true
EXECUTION_REQUIRE_MARKET_DATA_FOR_LIVE=true
EXECUTION_MAX_SIGNAL_AGE_SECONDS=300
EXECUTION_MAX_MARKET_DATA_AGE_SECONDS=60
# Normalized owner-scoped delayed BBOs are paper-only and use a distinct age ceiling.
EXECUTION_MAX_DELAYED_PAPER_MARKET_DATA_AGE_SECONDS=1800
EXECUTION_MAX_ACCOUNT_STATE_AGE_SECONDS=60
# Non-crypto entries require an official broker/exchange calendar observation
# newer than this; CLOSE signals remain eligible for risk reduction.
EXECUTION_MAX_MARKET_SESSION_AGE_SECONDS=3600
EXECUTION_RECON_POSITION_DRIFT_TOLERANCE=0.000001
EXECUTION_SHORT_ELIGIBLE_ASSET_CLASSES=
EXECUTION_ALERTS_ENABLED=true
EXECUTION_ALERT_ENVIRONMENTS=live
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TLS=true
# Optional overrides with mode-dependent defaults. Leave unset unless an
# operator deliberately changes the live-safety policy.
# EXECUTION_REQUIRE_ALERT_SINK=true
# EXECUTION_RECONCILIATION_INTERVAL_SEC=300
# EXECUTION_SANDBOX_CERTIFICATION_MARKER=.artifacts/coinbase_sandbox_certified.json

# Strategy selection is fail-closed. No catalogue candidate is staged by
# default; deployments must explicitly select reviewed operational strategies.
# Unfiltered discovery requires both ENVIRONMENT=dev and the override below.
STRATEGY_LIST=
INDICATOR_ALLOW_DEV_DISCOVERY=false
# Parent-process readiness SLOs for the durable strategy journal/relay.
INDICATOR_MAX_SIGNAL_BACKLOG_AGE_SECONDS=300
INDICATOR_MAX_STRATEGY_LAG_SECONDS=300
# Required together only for a synchronized panel worker. The activation
# cutoff is an explicit inclusive UTC decision-cutoff watermark; older exact-
# owner inputs are terminally skipped. Only paper_forward is accepted.
INDICATOR_PANEL_DATA_USE_SCOPE=
INDICATOR_PANEL_ENTITLEMENT_OWNER_USER_ID=
INDICATOR_PANEL_ACTIVATION_CUTOFF=

# Strategy runner runtime mode (defaults to EXECUTION_MODE in docker-compose.stack.yml)
RUN_MODE=paper

# =============================================================================
# Scoring Engine
# =============================================================================
# Host-run indicator workers only; leave unset for Compose service DNS.
# SIGNAL_API_URL=http://localhost:8001
HALF_LIFE_BARS=20
SCORE_WEIGHTS=
SCORING_PERSIST_DECISION_CONTEXT=true
SCORING_BINDINGS_CACHE_TTL_SECONDS=5
SCORING_CROSS_STRATEGY_ENSEMBLE=false
SCORING_SIBLING_FRESHNESS_SECONDS=3600
SCORING_MAX_SIBLINGS=16
SCORING_MULTI_FACTOR_ENABLED=false
SCORING_FACTOR_WEIGHTS=
SCORING_FACTOR_LOOKBACK=20
SCORING_FACTOR_WINSORIZE_Z=3.0
SCORING_MARKET_CONTEXT_SOURCE=coinbase_live
SCORING_MARKET_CONTEXT_TIMEFRAME=1m
SCORING_MARKET_CONTEXT_WINDOW=20
SCORING_MARKET_CONTEXT_MAX_AGE_SECONDS=3600
SCORING_OUTBOX_RELAY_INLINE=true
SCORING_OUTBOX_TOPICS=execution.commands,execution.rebalance.commands,signals.ingested,signals.scored,execution.results,feedback.ready
EVENT_BUS_PUBLISH_TOPICS=signals.ingested,signals.scored,execution.results,feedback.ready
SCORING_OUTBOX_POLL_SEC=2
SCORING_OUTBOX_BATCH_SIZE=100
SCORING_OUTBOX_LEASE_SEC=60
SCORING_OUTBOX_MAX_AGE_SECONDS=300

# =============================================================================
# Backend Config API (apps/backend)
# =============================================================================
# Admin API key for the tenant config API (sent as X-Admin-Key). REQUIRED in
# production — the service refuses to start when unset, unless
# BACKEND_ALLOW_ANON=true (explicit local-dev opt-out; never enable in prod).
# Generate a local key and store it only in your untracked .env, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ADMIN_API_KEY=
BACKEND_ALLOW_ANON=false

# =============================================================================
# Secrets backend (provider-agnostic; see docs/BROKER_CREDENTIALS.md §4)
# =============================================================================
# Selects where per-account TRADING credentials are resolved from. No cloud is
# assumed — pick the backend that fits your deploy:
#   env  (default)  — env var BROKER_CREDS_{REF} holds the JSON (local dev)
#   db              — encrypted at rest in Postgres (managed_secrets), using a
#                     newest-first Fernet key ring; supports per-user credential
#                     rotation without redeploying services.
#   composite       — db (if SECRETS_MASTER_KEYS is set) then env
SECRETS_BACKEND=env
# Comma-separated Fernet keys for SECRETS_BACKEND=db, newest first. Encryption
# uses the first key; decryption accepts every key. Store this variable in the
# deployment secret store, never commit it. Per-user broker credentials
# remain encrypted in the DB.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEYS=

# =============================================================================
# Broker Credentials
# =============================================================================
# Coinbase — Advanced Trade API, CDP key (create at https://portal.cdp.coinbase.com).
#   COINBASE_API_KEY    = CDP key NAME, e.g. organizations/<org-id>/apiKeys/<key-id>
#   COINBASE_API_SECRET = the key's secret. Two CDP key types are supported and
#       auto-detected: an EC private-key PEM (ECDSA/ES256 — paste single-line with
#       newlines escaped as \n) OR a base64 string (Ed25519/EdDSA — paste as-is,
#       single line). See docs/BROKER_CREDENTIALS.md.
# These two are used by the MARKET-DATA ingestor (candle backfill + live polling).
# Per-account TRADING creds are resolved via SECRETS_BACKEND (above), keyed by
# broker_credentials.secret_ref — see docs/BROKER_CREDENTIALS.md §4.
COINBASE_API_KEY=
COINBASE_API_SECRET=
# Deribit
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# Delta Exchange
DELTA_API_KEY=
DELTA_API_SECRET=

# Interactive Brokers — Client Portal Web API gateway (REST), NOT TWS.
# Run the IBKR Client Portal Gateway (clientportal.gw) and authenticate it in a
# browser (username/password + 2FA); both the market-data and broker adapters
# reach it over REST at this URL. (There is no ib_insync/TWS socket path.)
IBKR_GATEWAY_URL=https://localhost:5000
# Optional for localhost only: pin the gateway's self-signed TLS certificate.
# Non-loopback gateway URLs fail startup unless this certificate path is set;
# TLS verification is never disabled for a remote gateway.
IBKR_CA_CERT=
# NOTE: the IBKR account id is NOT an env var — it is carried per user in the
# broker credential JSON ('subaccount'). The old IBKR_ACCOUNT_ID / IBKR_TWS_PORT
# vars were never read by code and have been removed.

# Zerodha
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# The shared feed uses a dedicated platform data entitlement, never an end
# user's execution credential. Kite tokens expire daily.
ZERODHA_MARKET_DATA_API_KEY=
ZERODHA_MARKET_DATA_ACCESS_TOKEN=

# Saxo OpenAPI chart access. Select the immutable source label
# INGESTOR_SOURCE=saxo_live or saxo_simulation; there is no generic "saxo"
# fallback. OAuth tokens are short-lived and fail closed at/near their RFC3339
# expiry. These are dedicated platform market-data credentials, never a
# tenant's execution credential. The account key is optional when the chart
# entitlement does not require account context.
SAXO_MARKET_DATA_ACCESS_TOKEN=
SAXO_MARKET_DATA_ACCESS_TOKEN_EXPIRES_AT=
SAXO_MARKET_DATA_ACCOUNT_KEY=

# Official non-crypto market-session writers. Selectors are canonical symbols;
# conids, UIC/AssetType pairs, and Kite tokens are resolved from the database
# catalogue. Each profile fails startup when its selector or required credential
# is missing. Never enable two writers for the same canonical instrument.
#
# docker compose --env-file .env -f docker/docker-compose.stack.yml \
#   --profile calendar-ibkr up -d market-calendar-ibkr
IBKR_MARKET_CALENDAR_SYMBOLS=
IBKR_MARKET_CALENDAR_POLL_INTERVAL_SEC=300
SAXO_MARKET_CALENDAR_SYMBOLS=
SAXO_MARKET_CALENDAR_POLL_INTERVAL_SEC=300
ZERODHA_MARKET_CALENDAR_SYMBOLS=
ZERODHA_MARKET_CALENDAR_POLL_INTERVAL_SEC=30
# Exact `market` value from NSE's official /api/marketStatus response.
ZERODHA_MARKET_CALENDAR_NSE_MARKET=Capital Market
# Positive authorization exists only for this bounded official-state lease.
ZERODHA_MARKET_CALENDAR_NSE_LEASE_SECONDS=120

# ── Market data ingestion ────────────────────────────────────────────────────
# Canonical symbols or configured aliases to ingest. The service resolves each
# selector through instruments + instrument_broker_symbols for INGESTOR_SOURCE;
# opaque venue ids never belong here. USDC-quoted Coinbase aliases are the
# deployed default because the traded pair, ingested pair, and binding
# instruments_allowed must agree on quote currency.
INGESTOR_SYMBOLS=BTC-USDC,ETH-USDC,SOL-USDC
# Immutable provider provenance. Supported values are documented in
# docs/CONFIGURATION.md; aliases and cross-venue fallback are rejected.
INGESTOR_SOURCE=coinbase_live
INGESTOR_GRANULARITY=ONE_MINUTE
INGESTOR_POLL_INTERVAL_SEC=60
# The live process owns only this short startup request. The days-scale warmup
# runs in the isolated `market-data-backfill` Compose profile, using this same
# source, exact catalogue instruments, and dedicated venue credentials.
INGESTOR_BACKFILL_MINUTES=180
INGESTOR_BACKFILL_DAYS=150

# Personal US-equity research and optional owner-scoped delayed paper quotes.
# The token remains confined to acquisition/ingestion and is never provided to
# execution or accepted as live authority. EDGAR requires a contact user agent.
EODHD_API_TOKEN=
EDGAR_USER_AGENT=
# A one-shot import uses the existing market-data-ingestor image and accepts
# only an immutable factor manifest containing a qualified symbolic database
# evidence bundle. Current EODHD reconstructed membership lacks historical
# publication timestamps and therefore fails this gate before any DB write.
SP500_RESEARCH_ARTIFACT_ROOT=
SP500_RESEARCH_FACTOR_MANIFEST=
SP500_RESEARCH_OWNER_USER_ID=
EODHD_DELAYED_QUOTES_ENABLED=false
# Default-off one-shot US Quality Compounder panel producer. Run only after the
# official quarter-end close and before the next XNYS open. Owner and commission
# are mandatory when enabled; no funding, account, or execution authority is
# inferred from these research settings.
QUALITY_COMPOUNDER_PANELS_ENABLED=false
QUALITY_COMPOUNDER_ENTITLEMENT_OWNER_USER_ID=
QUALITY_COMPOUNDER_ROUND_TRIP_COMMISSION_BPS=
# Exact output and printed SHA-256 from the validation runtime's
# `equity_run compile-official-sessions` command; used only by the explicit
# calendar-import command.
QUALITY_COMPOUNDER_OFFICIAL_SESSION_ARTIFACT=
QUALITY_COMPOUNDER_OFFICIAL_SESSION_SHA256=
# Reviewed canonical JSON containing exact US-equity catalogue fields, positive
# whole-share lot sizes, and positive IBKR STK conIds. Apply is opt-in.
EQUITY_CATALOGUE_ARTIFACT=
EQUITY_CATALOGUE_SHA256=
EQUITY_CATALOGUE_DRY_RUN=true
# The quote loop and symbol-by-symbol daily-bar loop share one process but have
# separate cadences; the candle cadence must not be lower than the quote cadence.
EQUITY_INGESTOR_POLL_INTERVAL_SEC=300
EQUITY_INGESTOR_CANDLE_POLL_INTERVAL_SEC=3600
# HTTP 402 opens the live-ingestor circuit through EODHD's next midnight-UTC
# reset and for at least this many seconds (strict range: 60..86400).
EODHD_DAILY_QUOTA_MIN_COOLDOWN_SEC=900

# Independent observed-FX process. It persists official ECB EUR reference rates
# and real Coinbase USDC-EUR hourly candles; execution never assumes USDC/USD
# parity. The Coinbase leg is intentionally fixed to USDC-EUR and rejects any
# other product.
FX_RATE_CURRENCIES=USD,GBP,INR
FX_RATE_HISTORY_DAYS=90
FX_RATE_POLL_INTERVAL_SEC=21600
FX_RATE_COINBASE_PRODUCT=USDC-EUR

# Execution rejects a required conversion when its newest eligible observation
# is older than this point-in-time freshness window (default: three days, enough
# to bridge an ECB weekend; maximum accepted by the service is seven days).
EXECUTION_FX_MAX_AGE_SECONDS=259200
