*.pem

# Docker
# NOTE: .dockerignore is intentionally TRACKED — it is shared build config that
# must ship so its exclusions apply in CI/deploy builds, not local-only.
docker-compose.override.yml

# Temporary
tmp/
artifacts/optimization/
artifacts/
temp/
*.tmp
.leanhome/
.CLAUDE/
.claude/
.codex/

# LEAN market data: bulk data (price zips/csvs) is sourced externally at runtime
# (GCS bucket / `lean data download`), NOT committed. Keep ONLY the small
# config-like databases LEAN reads from Data/. These 3 are tracked; everything
# else under Data/ is ignored so the ~630 MB bulk set never re-enters history.
/Data/*
!/Data/market-hours/
!/Data/symbol-properties/
/Data/market-hours/*
!/Data/market-hours/market-hours-database.json
/Data/symbol-properties/*
!/Data/symbol-properties/symbol-properties-database.csv
!/Data/symbol-properties/security-database.csv

.next/
*.tsbuildinfo
# uv
.uv/

# Database files (SQLite)
*.db
*.sqlite
*.sqlite3

# Temporary reports and documentation (generated during development)
*_REPORT.md
*_REPORT.txt
*_RESULTS.md
*_SUMMARY.md
*_VERIFICATION*.md
*_COMPLETE.md
*_PROGRESS.md
*_PROGRESS.txt
*_PLAN.md
*_ANALYSIS.md
*_INSTRUCTIONS.md

# Local backtest exports (stakeholder-grade CSVs should be shared
